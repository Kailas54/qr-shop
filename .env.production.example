# Production checklist — set these on Render (API) and in Vercel project env (frontends).
# Never commit real secrets. Rotate demo passwords before going live.

NODE_ENV=production
PORT=10000

# Neon: pooled host (-pooler) + direct host (no -pooler). Console paste is OK —
# the API adds sslmode=require, connection_limit=5, pool_timeout, connect_timeout if missing.
# Example pooled: postgresql://...@ep-xxx-pooler....neon.tech/neondb?sslmode=require
DATABASE_URL=
DIRECT_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
GUEST_JWT_SECRET=

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# Public URLs after deploy (no trailing slash)
CUSTOMER_APP_URL=https://your-customer.vercel.app
ADMIN_APP_URL=https://your-admin.vercel.app
CORS_ORIGINS=https://your-customer.vercel.app,https://your-admin.vercel.app

# Menu images on Render: use Cloudinary (local disk is ephemeral)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel build-time only (admin-web / customer-web projects)
# VITE_API_URL=https://your-api.onrender.com
