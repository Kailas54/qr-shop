{
  "name": "qr-ordering-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "db:deploy:prod": "prisma migrate deploy",
    "db:seed": "dotenv -e ../.env -- prisma db seed",
    "db:check": "dotenv -e ../.env -- tsx src/scripts/db-check.ts",
    "db:neon:validate": "dotenv -e ../.env -- tsx scripts/validate-neon-env.ts",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "db:local:status": "node scripts/local-postgres.mjs status",
    "test": "dotenv -e ../.env -- vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "archiver": "^7.0.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "pino-http": "^10.4.0",
    "pusher": "^5.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/archiver": "^6.0.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/qrcode": "^1.5.5",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^8.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.6.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
