// Runtime queries use DATABASE_URL (Neon pooled host, hostname contains "-pooler").
// Migrations use DIRECT_URL (Neon direct host, no pooler).
// Both Neon URLs must include sslmode=require. Keep connection_limit between 1 and 10.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  owner
  manager
  waiter
  kitchen

  @@map("admin_role")
}

enum SessionStatus {
  open
  closed

  @@map("session_status")
}

enum OrderStatus {
  pending_confirmation
  placed
  accepted
  preparing
  served
  paid
  cancelled

  @@map("order_status")
}

model Restaurant {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  requireStaffOpen Boolean  @default(true) @map("require_staff_open")
  createdAt        DateTime @default(now()) @map("created_at")

  admins     Admin[]
  tables     Table[]
  categories Category[]
  menuItems  MenuItem[]
  orders     Order[]

  @@map("restaurants")
}

model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole
  createdAt    DateTime  @default(now()) @map("created_at")

  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  openedSessions TableSession[] @relation("SessionOpenedBy")

  @@index([restaurantId])
  @@map("admins")
}

model Table {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  tableNumber  String  @map("table_number")
  qrToken      String  @unique @map("qr_token")
  isActive     Boolean @default(true) @map("is_active")

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  sessions   TableSession[]
  orders     Order[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@map("tables")
}

model TableSession {
  id               String        @id @default(uuid()) @db.Uuid
  tableId          String        @map("table_id") @db.Uuid
  status           SessionStatus @default(open)
  pinHash          String        @map("pin_hash")
  openedBy         String?       @map("opened_by") @db.Uuid
  openedAt         DateTime      @default(now()) @map("opened_at")
  expiresAt        DateTime      @map("expires_at")
  closedAt         DateTime?     @map("closed_at")
  isFlaggedAbusive Boolean       @default(false) @map("is_flagged_abusive")

  table  Table   @relation(fields: [tableId], references: [id], onDelete: Restrict)
  opener Admin?  @relation("SessionOpenedBy", fields: [openedBy], references: [id], onDelete: SetNull)
  orders Order[]

  @@index([tableId, status])
  @@index([status, expiresAt])
  @@map("table_sessions")
}

model Category {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid
  name         String
  sortOrder    Int    @default(0) @map("sort_order")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items      MenuItem[]

  @@index([restaurantId, sortOrder])
  @@map("categories")
}

model MenuItem {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  categoryId   String  @map("category_id") @db.Uuid
  name         String
  description  String  @default("")
  price        Int
  imageUrl     String? @map("image_url")
  isAvailable  Boolean @default(true) @map("is_available")
  isVeg        Boolean @default(true) @map("is_veg")
  sortOrder    Int     @default(0) @map("sort_order")

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([restaurantId, isAvailable])
  @@index([categoryId, sortOrder])
  @@map("menu_items")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  restaurantId   String      @map("restaurant_id") @db.Uuid
  tableId        String      @map("table_id") @db.Uuid
  tableSessionId String      @map("table_session_id") @db.Uuid
  status         OrderStatus @default(placed)
  subtotal       Int
  total          Int
  notes          String      @default("")
  idempotencyKey String      @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  table        Table        @relation(fields: [tableId], references: [id], onDelete: Restrict)
  tableSession TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  events       OrderEvent[]

  @@unique([tableSessionId, idempotencyKey])
  @@index([restaurantId, status, createdAt])
  @@index([tableSessionId])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  menuItemId     String @map("menu_item_id") @db.Uuid
  nameSnapshot   String @map("name_snapshot")
  priceSnapshot  Int    @map("price_snapshot")
  quantity       Int
  customizations Json   @default("{}")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  String?      @map("changed_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}
