# Copy to .env for local development:  Copy-Item .env.example .env
# Never commit .env.

# -----------------------------------------------------------------------------
# Database
# Runtime API uses DATABASE_URL. Prisma migrations use DIRECT_URL.
# Local (embedded Postgres or Docker): both URLs can point at the same database.
# Optional: LOCAL_PG_PORT=5433 when starting embedded Postgres if 5432 is busy.
# Neon: DATABASE_URL host must contain "-pooler", DIRECT_URL must not.
# Neon: both URLs must include sslmode=require.
# Neon: set connection_limit between 1 and 10 on DATABASE_URL.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://qr:qr@localhost:5432/qr_ordering?schema=public&connection_limit=5&pool_timeout=10
DIRECT_URL=postgresql://qr:qr@localhost:5432/qr_ordering?schema=public

# Neon examples (replace with the strings from the Neon dashboard):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=15
# DIRECT_URL=postgresql://USER:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

NODE_ENV=development
PORT=4000

# At least 32 characters each. They must differ.
# Production refuses values that contain "change-me" or start with "dev-".
JWT_SECRET=change-me-staff-jwt-secret-min-32-chars
GUEST_JWT_SECRET=change-me-guest-jwt-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Pusher Channels (free Sandbox). UAE: cluster ap4 (Mumbai) or eu. No spaces around =, no quotes.
# Optional in development. Required when NODE_ENV=production.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

CUSTOMER_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Open table sessions expire after this many hours (default 3).
SESSION_TTL_HOURS=3

# local (disk, development) | cloudinary | vercel_blob
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BLOB_READ_WRITE_TOKEN=

# Order safety limits. Prices are integer paise (₹1 = 100).
MAX_ITEMS_PER_ORDER=30
MAX_QTY_PER_ITEM=20
# Totals at or above this many paise are flagged for staff review. 500000 = ₹5000.
ORDER_VALUE_REVIEW_THRESHOLD=500000

# bcrypt cost. Minimum 12.
BCRYPT_COST=12
